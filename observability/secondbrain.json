      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(secondbrain_document_uploads_total{service_name=\"secondbrain\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
