# Copy to .env and replace this placeholder before starting the database.
# Use plain KEY=value entries without shell exports or surrounding quotes.
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=secondbrain
POSTGRES_USER=secondbrain
POSTGRES_PORT=5432

# Optional embedding HTTP adapter; construction never calls the provider.
# Keep disabled for normal startup. Never commit real credentials.
SECONDBRAIN_EMBEDDINGS_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=
CLOUDFLARE_EMBEDDING_DIMENSIONS=0
